# Copy this file to .env and fill it in. Never share .env, commit it, or paste it into a chat.
WP_URL=https://growdigitalny.com
WP_USER=your-wordpress-username
# WordPress → Users → Profile → Application Passwords → "Claude Code" → Add New
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# Hostinger SSH + WP-CLI (optional, only if your plan has SSH)
# Find these in hPanel → Advanced → SSH Access. Use an SSH key (add it there), not a password.
SSH_HOST=
SSH_PORT=65002
SSH_USER=
# Usually /home/<ssh-user>/domains/growdigitalny.com/public_html (check in hPanel File Manager)
WP_PATH=
