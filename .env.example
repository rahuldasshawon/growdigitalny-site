# Copy this file to .env and fill it in. Never share .env or paste it into a chat.
WP_URL=https://growdigitalny.com
WP_USER=your-wordpress-username
# WordPress → Users → Profile → Application Passwords → "Claude Code" → Add New
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# Optional: only if your host gives you SSH + WP-CLI (makes Elementor/SEO edits easier)
SSH_HOST=
SSH_USER=
WP_PATH=/path/to/public_html
